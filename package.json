{
  "name": "xpos",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:turbo": "turbo run dev",
    "dev:api": "npm --prefix apps/api run dev",
    "dev:customer": "npm --prefix apps/customer run dev",
    "dev:kiosk": "npm --prefix apps/kiosk run dev",
    "dev:admin": "npm --prefix apps/admin run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "cd packages/database && npx prisma generate",
    "db:migrate": "cd packages/database && npx prisma migrate dev",
    "db:seed": "cd packages/database && npx prisma db seed",
    "db:studio": "cd packages/database && npx prisma studio",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "setup": "npm install && npm run db:generate && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "turbo": "^2.1.0"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
